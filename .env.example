# ── Required ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://equalpath:equalpath@localhost:5432/equalpath"
# Supabase: use the pooled URL above (add ?sslmode=require) and the direct URL here for migrations
DIRECT_URL="postgresql://equalpath:equalpath@localhost:5432/equalpath"
# 32 random bytes, base64. Generate with: npm run keygen   (NEVER commit; losing it = losing encrypted data)
ENCRYPTION_KEY=""
# ENCRYPTION_KEY_PREVIOUS=""   # set during key rotation so old data still decrypts
APP_URL="http://localhost:3000"
CRON_SECRET=""                 # long random string; Vercel Cron sends it as a Bearer token

# ── AI (optional; rule-based fallbacks are used when unset) ───────────────
# LLM_PROVIDER="anthropic"     # anthropic | gemini | openai | none (auto-detected from keys)
ANTHROPIC_API_KEY=""           # https://console.anthropic.com/settings/keys
GEMINI_API_KEY=""              # https://aistudio.google.com/apikey
# GEMINI_MODEL="gemini-3.6-flash"  # optional; any current model name from ai.google.dev/gemini-api/docs/models
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL=""                 # optional model override for the chosen provider

# ── Object storage (resumes are AES-256-GCM encrypted before upload) ──────
STORAGE_DRIVER="local"         # local | supabase
LOCAL_STORAGE_DIR="./storage"
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY="" # server-only; never expose to the browser
# STORAGE_BUCKET="resumes"     # create as a PRIVATE bucket

# ── Job sources (each adapter is enabled only when its variables are set) ─
GREENHOUSE_BOARDS=""           # comma list of board tokens, optional display name: "acme:Acme Corp,globex"
LEVER_COMPANIES=""             # comma list of Lever site names: "acme:Acme Corp"
USAJOBS_API_KEY=""             # free: https://developer.usajobs.gov/
USAJOBS_USER_AGENT_EMAIL=""    # the email you registered with USAJOBS
# USAJOBS_KEYWORDS=""
ADZUNA_APP_ID=""               # https://developer.adzuna.com/
ADZUNA_APP_KEY=""
# ADZUNA_COUNTRY="us"  ADZUNA_PAGES="3"  ADZUNA_WHAT=""
EMPLOYER_FEEDS=""              # "Agency Name|https://feed.example/jobs.json" (schema.org JobPosting), only with written authorization
# EMPLOYER_FEEDS_TOKEN=""
# Indeed / LinkedIn: only after a signed partner agreement
# INDEED_PARTNER_CLIENT_ID="" INDEED_PARTNER_CLIENT_SECRET="" INDEED_PARTNER_APPROVED="false"
# LINKEDIN_PARTNER_CLIENT_ID="" LINKEDIN_PARTNER_CLIENT_SECRET="" LINKEDIN_PARTNER_APPROVED="false"
JOB_DAILY_TARGET="50"
JOB_STALE_AFTER_HOURS="48"
# ALERT_WEBHOOK_URL=""         # Slack/Teams-compatible webhook for low-count & failure alerts

# ── Development only ──────────────────────────────────────────────────────
ENABLE_DEMO_JOBS="false"       # DEMO jobs are refused when NODE_ENV=production
# SEED_ADMIN_EMAIL="admin@equalpath.local"
# SEED_ADMIN_PASSWORD=""
