#!/bin/sh
# Blocks commits that include .env files or strings that look like API keys.
staged=$(git diff --cached --name-only --diff-filter=ACM)
for f in $staged; do
  case "$f" in
    .env.example) ;;
    .env|.env.*|*/.env|*/.env.*) echo "✗ Refusing to commit $f (secrets belong in .env, which stays local)"; exit 1 ;;
  esac
done
if git diff --cached -U0 -- . ':(exclude).githooks/pre-commit' | grep -E '^\+' | grep -qE '(sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|AIza[0-9A-Za-z_-]{35}|ghp_[A-Za-z0-9]{36})'; then
  echo "✗ A staged change looks like it contains an API key. Move it to .env and try again."
  exit 1
fi
